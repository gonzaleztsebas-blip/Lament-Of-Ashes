<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="640.0" style="-fx-background-color: #272744;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lamentofashes.controllers.ConsumableSelectionController">

    <VBox alignment="CENTER" prefHeight="460.0" prefWidth="640.0" spacing="15.0">

        <!-- Título -->
        <Label fx:id="titleLabel" alignment="CENTER" prefHeight="103.0" prefWidth="640.0" style="-fx-text-fill: #fbf5ef; -fx-font-size: 45px; -fx-font-family: 'PixelPlay';" textAlignment="CENTER" wrapText="true" />

        <!-- Descripción -->
        <Label fx:id="descriptionLabel" alignment="CENTER" prefHeight="83.0" prefWidth="640.0" style="-fx-text-fill: #fbf5ef; -fx-font-size: 30px; -fx-font-family: 'PixelPlay';" textAlignment="CENTER" wrapText="true" />

        <!-- Opciones de equipamiento -->
        <HBox alignment="CENTER" prefHeight="353.0" prefWidth="640.0" spacing="30">

            <!-- Opción 1 -->
            <VBox fx:id="option1Box" alignment="CENTER" onMouseClicked="#onOption1Clicked" prefHeight="300.0" prefWidth="180.0" spacing="10.0" style="-fx-background-color: #8b6d9c; -fx-padding: 20; -fx-border-color: #fbf5ef;                          -fx-border-width: 2; -fx-cursor: hand;">

                <ImageView fx:id="option1Image" fitHeight="96.0" fitWidth="96.0" preserveRatio="true" />

                <Label fx:id="option1Name" alignment="CENTER" prefHeight="110.0" prefWidth="136.0" style="-fx-text-fill: #fbf5ef; -fx-font-size: 24px; -fx-font-weight: bold;                               -fx-font-family: 'PixelPlay';" textAlignment="CENTER" wrapText="true" />

                <Label fx:id="option1Stats" alignment="CENTER" prefHeight="110.0" prefWidth="136.0" style="-fx-text-fill: #fbf5ef; -fx-font-size: 18px; -fx-font-family: 'PixelPlay';" textAlignment="CENTER" wrapText="true" />
            </VBox>

            <!-- Opción 2 -->
            <VBox fx:id="option2Box" alignment="CENTER" onMouseClicked="#onOption2Clicked" prefHeight="313.0" prefWidth="180.0" spacing="10.0" style="-fx-background-color: #8b6d9c; -fx-padding: 20; -fx-border-color: #fbf5ef;                          -fx-border-width: 2; -fx-cursor: hand;">

                <ImageView fx:id="option2Image" fitHeight="96.0" fitWidth="96.0" preserveRatio="true" />

                <Label fx:id="option2Name" alignment="CENTER" prefHeight="110.0" prefWidth="136.0" style="-fx-text-fill: #fbf5ef; -fx-font-size: 24px; -fx-font-weight: bold;                               -fx-font-family: 'PixelPlay';" textAlignment="CENTER" wrapText="true" />

                <Label fx:id="option2Stats" alignment="CENTER" prefHeight="110.0" prefWidth="136.0" style="-fx-text-fill: #fbf5ef; -fx-font-size: 18px; -fx-font-family: 'PixelPlay';" textAlignment="CENTER" wrapText="true" />
            </VBox>

            <!-- Opción 3 -->
            <VBox fx:id="option3Box" alignment="CENTER" onMouseClicked="#onOption3Clicked" prefHeight="300.0" prefWidth="180.0" spacing="10.0" style="-fx-background-color: #8b6d9c; -fx-padding: 20; -fx-border-color: #fbf5ef;                          -fx-border-width: 2; -fx-cursor: hand;">

                <ImageView fx:id="option3Image" fitHeight="96.0" fitWidth="96.0" preserveRatio="true" />

                <Label fx:id="option3Name" alignment="CENTER" prefHeight="110.0" prefWidth="136.0" style="-fx-text-fill: #fbf5ef; -fx-font-size: 24px; -fx-font-weight: bold;                               -fx-font-family: 'PixelPlay';" textAlignment="CENTER" wrapText="true" />

                <Label fx:id="option3Stats" alignment="CENTER" prefHeight="110.0" prefWidth="136.0" style="-fx-text-fill: #fbf5ef; -fx-font-size: 18px; -fx-font-family: 'PixelPlay';" textAlignment="CENTER" wrapText="true" />
            <cursor>
               <Cursor fx:constant="HAND" />
            </cursor>
            </VBox>

        </HBox>

    </VBox>

</AnchorPane>
