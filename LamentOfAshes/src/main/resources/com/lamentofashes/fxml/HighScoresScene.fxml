<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane fx:id="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lamentofashes.controllers.HighScoresController">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="480.0" prefWidth="640.0" spacing="20.0" style="-fx-background-color: #272744;">
          
          <padding>
              <Insets bottom="30" left="30" right="30" top="30" />
          </padding>
          
          <!-- Título -->
          <Label fx:id="titulo" prefHeight="46.0" prefWidth="210.0" style="-fx-text-fill: #fbf5ef; -fx-font-size: 48px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold;" text="HIGH SCORES">
              <VBox.margin>
                  <Insets bottom="20" />
              </VBox.margin>
          </Label>
          
          <!-- Tabla de puntajes -->
          <ScrollPane fitToWidth="true" prefHeight="194.0" prefWidth="580.0" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: #f2d3ab; -fx-border-width: 3;" VBox.vgrow="ALWAYS">
              <VBox fx:id="scoresContainer" prefHeight="234.0" prefWidth="559.0" spacing="10" style="-fx-background-color: #3a3a5d; -fx-padding: 20;">
                  
                  <!-- Header -->
                  <HBox spacing="10" style="-fx-background-color: #494d7e; -fx-padding: 10; -fx-border-color: #f2d3ab; -fx-border-width: 0 0 2 0;">
                      <Label prefHeight="22.0" prefWidth="53.0" style="-fx-text-fill: #f2d3ab; -fx-font-size: 16px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold;" text="#" />
                      <Label prefHeight="22.0" prefWidth="92.0" style="-fx-text-fill: #f2d3ab; -fx-font-size: 16px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold;" text="JUGADOR" />
                      <Label alignment="CENTER" prefWidth="80" style="-fx-text-fill: #f2d3ab; -fx-font-size: 16px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold;" text="RONDA" />
                      <Label alignment="CENTER" prefWidth="100" style="-fx-text-fill: #f2d3ab; -fx-font-size: 16px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold;" text="ENEMIGOS" />
                      <Label alignment="CENTER" prefWidth="80" style="-fx-text-fill: #f2d3ab; -fx-font-size: 16px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold;" text="JEFES" />
                      <Label alignment="CENTER" prefWidth="100" style="-fx-text-fill: #f2d3ab; -fx-font-size: 16px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold;" text="DAÑO" />
                      <Label alignment="CENTER" prefWidth="100" style="-fx-text-fill: #f2d3ab; -fx-font-size: 16px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold;" text="TIEMPO" />
                      <Label alignment="CENTER" prefWidth="120" style="-fx-text-fill: #f2d3ab; -fx-font-size: 16px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold;" text="SCORE" />
                  </HBox>
                  
                  <!-- Los scores se agregarán dinámicamente aquí -->
                  
              </VBox>
          </ScrollPane>
          
          <!-- Botones -->
          <HBox alignment="CENTER" spacing="20">
              <Button fx:id="btnVolver" onAction="#onVolver" onMouseEntered="#onVolverHover" onMouseExited="#onVolverExit" prefHeight="50" prefWidth="150" style="-fx-background-color: #494d7e; -fx-text-fill: #fbf5ef; -fx-font-size: 18px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold; -fx-border-color: #f2d3ab; -fx-border-width: 2; -fx-background-radius: 0; -fx-border-radius: 0;" text="VOLVER">
                  <cursor>
                      <Cursor fx:constant="HAND" />
                  </cursor>
              </Button>
              
              <Button fx:id="btnLimpiar" onAction="#onLimpiar" onMouseEntered="#onLimpiarHover" onMouseExited="#onLimpiarExit" prefHeight="50" prefWidth="150" style="-fx-background-color: #ef4444; -fx-text-fill: #fbf5ef; -fx-font-size: 18px; -fx-font-family: 'PixelPlay'; -fx-font-weight: bold; -fx-border-color: #f2d3ab; -fx-border-width: 2; -fx-background-radius: 0; -fx-border-radius: 0;" text="LIMPIAR">
                  <cursor>
                      <Cursor fx:constant="HAND" />
                  </cursor>
              </Button>
          </HBox>
          
      </VBox>
   </children>
</AnchorPane>
