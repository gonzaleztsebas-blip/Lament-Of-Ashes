<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="480.0" prefWidth="640.0" 
            xmlns="http://javafx.com/javafx/25" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.lamentofashes.controllers.GameOverController">

    <children>

        <ImageView fx:id="backgroundImage"
                   fitHeight="480.0" fitWidth="640.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../../GameOverV2.png" />
            </image>
        </ImageView>

        <Label fx:id="verPuntajesLabel"
               accessibleRole="BUTTON" alignment="CENTER"
               layoutX="187.0" layoutY="400.0"
               onMouseClicked="#onVerPuntajes"
               prefHeight="53.0" prefWidth="266.0"
               style="-fx-border-width: 3; -fx-border-color: #fbf5ef;"
               text="Ver Mejores Puntajes" textAlignment="CENTER" textFill="#fbf5ef">
            <font>
                <Font name="PixelPlay Regular" size="31.0" />
            </font>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Label>

        <Pane fx:id="retryPane"
              layoutX="204.0" layoutY="284.0"
              onMouseClicked="#switchToTitleScene">
            <children>

                <Label fx:id="retryLabel"
                       accessibleRole="BUTTON" alignment="CENTER"
                       layoutY="26.0"
                       onMouseClicked="#switchToTitleScene"
                       prefHeight="27.0" prefWidth="233.0"
                       style="-fx-border-width: 0; -fx-border-color: #fbf5ef;"
                       text="Intentarlo de Nuevo?"
                       textAlignment="CENTER" textFill="#fbf5ef">
                    <font>
                        <Font name="PixelPlay Regular" size="27.0" />
                    </font>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </Label>

                <ImageView fx:id="retryImage"
                           fitHeight="93.0" fitWidth="234.0"
                           onMouseClicked="#switchToTitleScene"
                           pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../../../Button.png" />
                    </image>
                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>
                </ImageView>

            </children>
            <cursor>
                <Cursor fx:constant="HAND" />
            </cursor>
        </Pane>

    </children>

</AnchorPane>
